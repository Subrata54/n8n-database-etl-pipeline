    {
      "parameters": {
        "jsCode": "return items.map(item => {\n\n  return {\n    json: {\n      order_id: item.json.id,\n      email: item.json.email.toLowerCase(),\n      revenue: Number(item.json.amount),\n      created_at: item.json.created_at\n    }\n  };\n\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        304,
        -160
      ],
      "id": "d993bc1a-8060-45bd-b7f0-1564e3eed8bc",
      "name": "Code (Transform)"
    },
    {
      "parameters": {
        "jsCode": "for (const item of items) {\n\n  if (!item.json.email) {\n    throw new Error(\"Email Missing\");\n  }\n\n  if (!item.json.order_id) {\n    throw new Error(\"Order ID Missing\");\n  }\n\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        -160
      ],
      "id": "a32a2115-4bf5-4a14-a5eb-969aa7bcc24e",
      "name": "Code (Validate)"
    },
    {
      "parameters": {
        "jsCode": "const rows = [];\n\nfor (const item of items) {\n\n  for (const product of item.json.products) {\n\n    rows.push({\n      json: {\n        order_id: item.json.order_id,\n        product: product.name\n      }\n    });\n\n  }\n\n}\n\nreturn rows;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        -160
      ],
      "id": "ef6faa34-86be-4ba1-94fe-76975bf70a16",
      "name": "Code (Line Item Processing)"
    },
    {
      "parameters": {
        "jsCode": "const seen = new Set();\n\nreturn items.filter(item => {\n\n  if (seen.has(item.json.order_id)) {\n    return false;\n  }\n\n  seen.add(item.json.order_id);\n  return true;\n\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
